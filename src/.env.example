APP_NAME="WC-Info API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Europe/Berlin
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

# Make artisan serve listen on the IPv6 localhost address.
SERVER_HOST=[::1]

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=wcinfo
DB_USERNAME=wcinfo
DB_PASSWORD=secret

SESSION_DRIVER=file
QUEUE_CONNECTION=sync
CACHE_STORE=file

# SMTP configuration for PHPMailer
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USER=noreply@wc-info.de
SMTP_PASSWORD=
SMTP_ENCRYPTION=ssl
SENDER_MAIL=noreply@wc-info.de

# S3-compatible object storage (gos3)
S3_ENDPOINT=https://gos3.io
S3_KEY=
S3_SECRET=
S3_BUCKET=wcinfo
S3_PUBLIC_URL=https://wcinfo.eu-central-1.gos3.io/
S3_REGION=eu

# Google APIs
GOOGLE_API_KEY=

# Sentry
SENTRY_LDSN=
SENTRY_TRACES_SAMPLE_RATE=0.0

# Admin Panel Credentials
ADMIN_USER=admin
ADMIN_PASSWORD=secret

# Admin action link hashes
ADMIN_HASH_SECRET=
ADMIN_HASH_SECRET2=

# API Documentation
API_VERSION=2.0.0

# Place discovery cronjob
DISCOVER_PLACES_LIMIT=500
DISCOVER_PLACES_CACHE_DAYS=30
DISCOVER_PLACES_RADIUS=2000
